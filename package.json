{
  "name": "seren-docs",
  "version": "1.0.0",
  "description": "SerenAI Documentation - Pay Per Call Agentic Commerce for public and private data",
  "scripts": {
    "build": "node scripts/build.js",
    "build:api": "node scripts/build-html-docs.js",
    "build:llms": "node scripts/generate-llms-txt.js",
    "build:mcp": "node scripts/generate-mcp-docs.js",
    "fetch:openapi": "cp ../serencore/openapi/openapi.json openapi.json",
    "dev": "npm run build && npx http-server dist -p 3000 -c-1",
    "clean": "rm -rf dist && mkdir -p dist"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "marked": "^11.1.1"
  },
  "author": "SerenAI",
